rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 1. Users Collection
    // ─────────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // User can read their own profile; admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // User can create/update their own profile
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.keys().hasAll(['uid', 'email', 'createdAt', 'isActive']);

      allow update: if isOwner(userId) &&
        // Prevent normal users from escalating their role or tier
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tier']) || isAdmin());

      allow delete: if isAdmin();

      // Nested devices subcollection for this user
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Security audit trail subcollection for this user
      match /securityLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 2. Global Devices Collection (for device verification & fast lookup)
    // ─────────────────────────────────────────────────────────────────────────────
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 3. P2P Mesh Nodes (Exit Gateways & Relays)
    // ─────────────────────────────────────────────────────────────────────────────
    match /p2p_nodes/{nodeId} {
      // Authenticated users can discover active/verified nodes
      allow read: if isAuthenticated();

      // Only node owner can register or update node telemetry
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 4. P2P Connection Sessions (Audit Trail & Billing)
    // ─────────────────────────────────────────────────────────────────────────────
    match /p2p_sessions/{sessionId} {
      // Clients or host node owners can view sessions they participate in
      allow read: if isAuthenticated() && 
        (resource.data.clientUid == request.auth.uid || 
         resource.data.hostUid == request.auth.uid || 
         isAdmin());

      // Sessions can be initiated by client or host node
      allow create: if isAuthenticated() && request.resource.data.clientUid == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.clientUid == request.auth.uid || resource.data.hostUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 5. Security & Threat Telemetry Events (SOC / URLhaus / Firewall Logs)
    // ─────────────────────────────────────────────────────────────────────────────
    match /security_events/{eventId} {
      // Users can see their own threat detections; admins can see all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Device can record a new security threat detection
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 6. Legacy / Existing P2P Pairings (Ephemeral handshakes)
    // ─────────────────────────────────────────────────────────────────────────────
    match /pairings/{pairingToken} {
      allow read, write: if isAuthenticated();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
