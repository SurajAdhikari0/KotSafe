<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: only trust system CA roots, prohibit cleartext traffic globally in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP/WS for local proxy, SOCKS5 loopback, and KotSafe direct VPS / P2P relay -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Allow user certificates (e.g. proxy/testing CAs) only in debug builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
