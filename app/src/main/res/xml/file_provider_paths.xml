<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Expose files from external storage (Downloads, etc.) -->
    <external-path name="external_files" path="." />
    <!-- Expose files from app-private external storage -->
    <external-files-path name="external_app_files" path="." />
    <!-- Expose files from internal cache (temp exports, logs, APK copies) -->
    <cache-path name="cache_files" path="." />
    <!-- Expose designated exports subfolder only -->
    <files-path name="internal_exports" path="exports/" />
</paths>
