<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Expose files from external storage (Downloads, etc.) -->
    <external-path name="external_files" path="." />
    <!-- Expose files from app-private external storage -->
    <external-files-path name="external_app_files" path="." />
    <!-- Expose files from internal cache (temp copies of APKs from content URIs) -->
    <cache-path name="cache_files" path="." />
    <!-- Expose files from internal files dir -->
    <files-path name="internal_files" path="." />
</paths>
