<?xml version="1.0" encoding="utf-8"?>
<!-- Main shield circle button background - Cyber Glassmorphic Warning -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F59E0B">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#2A1B0D"
                        android:centerColor="#1B1208"
                        android:endColor="#0C0803"
                        android:type="linear" />
                    <stroke
                        android:width="3dp"
                        android:color="#F59E0B" />
                </shape>
            </item>
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="1dp"
                        android:color="#3D2708" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
