<?xml version="1.0" encoding="utf-8"?>
<!-- Main shield circle button background - Cyber Glassmorphic Active -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300E5FF">
    <item>
        <layer-list>
            <!-- Outer cyber tech stroke & deep gradient disc -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#0F172A"
                        android:centerColor="#0B132B"
                        android:endColor="#030712"
                        android:type="linear" />
                    <stroke
                        android:width="3dp"
                        android:color="#00E5FF" />
                </shape>
            </item>
            <!-- Inner subtle telemetry orbit rim -->
            <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
                <shape android:shape="oval">
                    <stroke
                        android:width="1dp"
                        android:color="#1E293B" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
