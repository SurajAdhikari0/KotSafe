<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Tactical Ring with Emerald Stroke -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/statusCircleGradStart"
                android:centerColor="@color/statusCircleGradMid"
                android:endColor="@color/statusCircleGradEnd"
                android:type="linear" />
            <stroke
                android:width="3.5dp"
                android:color="@color/statusCircleStroke" />
        </shape>
    </item>
    <!-- Secondary Concentric Tactical Accent Ring -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/cardWorkbenchBorder" />
        </shape>
    </item>
</layer-list>
