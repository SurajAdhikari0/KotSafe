<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- NOTE: "always|collapseActionView" must be set to prevent the search button from
         disappearing and to avoid hiding the other elements. -->
    <item
        android:id="@+id/search"
        android:title="@string/search"
        android:icon="@drawable/ic_search"
        android:orderInCategory="15"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="always|collapseActionView"
        tools:ignore="AlwaysShowAction" />

    <item
        android:id="@+id/sort_connections"
        android:title="@string/sort_by"
        android:icon="@drawable/ic_sort"
        android:orderInCategory="18"
        app:showAsAction="always" />

    <item
        android:id="@+id/edit_filter"
        android:title="@string/edit_filter"
        android:icon="@drawable/ic_filter"
        android:orderInCategory="20"
        app:showAsAction="always">
    </item>

    <item
        android:id="@+id/save"
        android:title="@string/save_as_csv"
        android:orderInCategory="30"
        android:icon="@drawable/ic_save"
        app:showAsAction="never" />

    <item
        android:id="@+id/toggle_group_by_app"
        android:title="@string/group_by_app"
        android:orderInCategory="34"
        android:checkable="true"
        app:showAsAction="never" />

    <item
        android:id="@+id/toggle_single_socket_mode"
        android:title="@string/single_socket_diagnostics_title"
        android:orderInCategory="35"
        android:checkable="true"
        app:showAsAction="never" />

    <item
        android:id="@+id/toggle_hide_system_traffic"
        android:title="@string/hide_system_traffic"
        android:orderInCategory="36"
        android:checkable="true"
        app:showAsAction="never" />

    <item
        android:id="@+id/toggle_auto_move_closed"
        android:title="Move closed services to Closed tab"
        android:orderInCategory="37"
        android:checkable="true"
        app:showAsAction="never" />

    <item
        android:id="@+id/simulate_test_traffic"
        android:title="Simulate Deduplicated Flows"
        android:orderInCategory="38"
        app:showAsAction="never" />

    <item
        android:id="@+id/switch_to_http_log"
        android:visible="false" />
</menu>