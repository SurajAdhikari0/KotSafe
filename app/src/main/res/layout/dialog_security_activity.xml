<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/profile_dialog_bg"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header: Back + Title + Refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back_security_activity"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/profileTextPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security Activity"
                    android:textColor="@color/profileTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Recent sign-ins and identity events"
                    android:textColor="@color/profileTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_refresh_security_activity"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/profileTextSecondary" />
        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progress_security_activity"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="20dp"
            android:indeterminateTint="@color/profileAccent"
            android:visibility="gone" />

        <!-- Empty state text -->
        <TextView
            android:id="@+id/tv_empty_security_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:gravity="center"
            android:text="No recent security alerts.\nYour account activity is clean and protected."
            android:textColor="@color/profileTextSecondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Scrollable list container in a Card -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/container_security_activity_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:divider="?android:attr/dividerHorizontal"
                android:orientation="vertical"
                android:padding="12dp"
                android:showDividers="middle" />
        </androidx.core.widget.NestedScrollView>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btn_close_security_activity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_profile_outline_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Close"
            android:textColor="@color/profileTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
