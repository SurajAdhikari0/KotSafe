<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?android:attr/windowBackground">

    <!-- Threat icon and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/iv_threat_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_shield" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_threat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Threat Detected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF3B30" />

            <TextView
                android:id="@+id/tv_threat_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FF6B6B"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Details -->
    <TextView
        android:id="@+id/tv_threat_package"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_threat_sha256"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="?android:textColorSecondary"
        android:layout_marginBottom="24dp" />

    <!-- Action buttons -->
    <Button
        android:id="@+id/btn_block_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛡 Block App"
        android:backgroundTint="#FF3B30"
        android:textColor="@android:color/white"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_uninstall_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑 Uninstall"
        android:backgroundTint="#FF9500"
        android:textColor="@android:color/white"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_dismiss_alert"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dismiss"
        android:textColor="?android:textColorSecondary" />

</LinearLayout>
