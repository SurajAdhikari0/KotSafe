<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#306366F1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pref_tls"
                app:tint="@color/colorAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="PROTOCOL INSPECTOR"
                android:textAllCaps="true"
                android:textColor="@color/colorAccent"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap a protocol to see how KotSafe dissects it live:"
            android:textColor="@color/colorTabText"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proto_tls"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="TLS 1.3"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    app:backgroundTint="@color/colorAccent"
                    app:cornerRadius="8dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proto_http2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="HTTP/2"
                    android:textAllCaps="false"
                    android:textColor="@color/drawerItemColor"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#406366F1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proto_quic"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="QUIC/UDP"
                    android:textAllCaps="false"
                    android:textColor="@color/drawerItemColor"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#406366F1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proto_dns"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="DNS"
                    android:textAllCaps="false"
                    android:textColor="@color/drawerItemColor"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#406366F1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proto_pcap"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="PCAPNG"
                    android:textAllCaps="false"
                    android:textColor="@color/drawerItemColor"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="#406366F1" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/proto_terminal_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_surface_secondary"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/proto_terminal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="TLS 1.3 Decryption Engine"
                android:textColor="@color/colorAccent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/proto_terminal_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="SNI: auth.example.com\nCipher: TLS_AES_256_GCM_SHA384\nStatus: Encrypted stream dissected via user CA"
                android:textColor="@color/drawerItemColor"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
