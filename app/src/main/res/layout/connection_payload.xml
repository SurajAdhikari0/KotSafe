<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/cord_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/no_payload"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No payload data captured yet\n(Waiting for application traffic)"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/metricTextSecondary"
        android:drawableTop="@drawable/ic_text_snippet"
        android:drawablePadding="16dp"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.kotsafe.security.views.EmptyRecyclerView
        android:id="@+id/payload"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:fillViewport="true" />

    <LinearLayout
        android:id="@+id/decryption_error_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_modern_bg"
        android:layout_margin="12dp"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/request_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/decryption_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/show_connection_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_connection" />
    </LinearLayout>

    <TextView
        android:id="@+id/truncated_warning"
        android:text="@string/payload_truncated"
        android:layout_width="match_parent"
        tools:visibility="visible"
        android:visibility="gone"
        android:background="@drawable/badge_pill_closed"
        android:textColor="@color/metricTextSecondary"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_height="wrap_content"/>
</LinearLayout>