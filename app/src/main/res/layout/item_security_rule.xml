<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/cardWorkbenchBg"
    app:strokeColor="@color/cardBorderSubtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Rule / App Icon -->
        <ImageView
            android:id="@+id/iv_rule_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/colorPrimary"
            android:contentDescription="Rule Icon" />

        <!-- Info column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tv_rule_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_rule_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/metricTextSecondary"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:background="#15888888"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_rule_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/metricTextSecondary"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:background="#15888888" />
            </LinearLayout>

            <!-- Value / Name -->
            <TextView
                android:id="@+id/tv_rule_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/metricTextPrimary"
                android:fontFamily="monospace"
                android:ellipsize="middle"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_rule_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/metricTextSecondary"
                android:ellipsize="middle"
                android:singleLine="true"
                android:visibility="gone" />

            <!-- Reason -->
            <TextView
                android:id="@+id/tv_rule_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/metricTextSecondary"
                android:ellipsize="end"
                android:singleLine="true"
                android:layout_marginTop="2dp" />

            <!-- Metadata Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_rule_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="10sp"
                    android:textColor="@color/metricTextSecondary" />

                <TextView
                    android:id="@+id/tv_rule_hits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorSecondary"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:background="#1A00D4FF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right action: Toggle Switch & Delete button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_rule_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

            <ImageButton
                android:id="@+id/btn_rule_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="?android:attr/textColorSecondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete rule" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
