<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/profile_dialog_bg"
    android:padding="22dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="@color/lightGray"
        android:alpha="0.4" />

    <!-- Header with Avatar & Tier -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_profile_avatar"
            app:tint="?attr/colorAccent"
            android:background="@drawable/pulse_ring"
            android:padding="8dp"
            android:contentDescription="@string/security_profile_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_suite_name"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/highContrast" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="@color/profileTierBadgeBg"
                    android:textColor="@color/profileTierBadgeFg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="@string/profile_tier_label" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_admin_role"
                android:textSize="13sp"
                android:textColor="@color/lightGray" />
        </LinearLayout>
    </LinearLayout>

    <!-- Threat Intel Stat Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Stat 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/profile_stat_card_bg"
            android:padding="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_signatures_count"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_signatures_label"
                android:textSize="10sp"
                android:gravity="center"
                android:textColor="@color/lightGray" />
        </LinearLayout>

        <!-- Stat 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/profile_stat_card_bg"
            android:padding="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_firewall_rules_count"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ok" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_firewall_rules_label"
                android:textSize="10sp"
                android:gravity="center"
                android:textColor="@color/lightGray" />
        </LinearLayout>

        <!-- Stat 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/profile_stat_card_bg"
            android:padding="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_protection_grade"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ok" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/profile_protection_label"
                android:textSize="10sp"
                android:gravity="center"
                android:textColor="@color/lightGray" />
        </LinearLayout>
    </LinearLayout>

    <!-- About KotSafe Integrated Section in Profile -->
    <LinearLayout
        android:id="@+id/card_profile_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/profile_stat_card_bg"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/nav_logo_bg" />
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KotSafe Security"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/highContrast" />

                <TextView
                    android:id="@+id/profile_about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="@color/profileTierBadgeBg"
                    android:textColor="@color/profileTierBadgeFg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="v2.0.1-beta" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="About, MITRE Matrix, Architecture &amp; Core Engines"
                android:textSize="11sp"
                android:textColor="@color/metricTextSecondary" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_navigate_next"
            app:tint="@color/lightGray"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Physical Security & Screen Peek Section in Profile -->
    <LinearLayout
        android:id="@+id/card_profile_physical_security"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/profile_stat_card_bg"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_lock"
            app:tint="#FFD54F"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physical Security"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/highContrast" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Anti-theft, App Gate &amp; Security Locks"
                android:textSize="11sp"
                android:textColor="@color/metricTextSecondary" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_navigate_next"
            app:tint="@color/lightGray"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Security Posture Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/profile_stat_card_bg"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Real-Time Zero-Trust Engine Active"
            android:textSize="12sp"
            android:textColor="@color/highContrast" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="🛡️ Dual-Mode (VPN + Passive API Sentinels)"
            android:textSize="12sp"
            android:textColor="@color/highContrast" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="⚡ High-Performance eBPF / Native Packet Ring Buffer"
            android:textSize="12sp"
            android:textColor="@color/highContrast" />
    </LinearLayout>

    <!-- Bottom Buttons: Open About and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_profile_about"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/about"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:icon="@drawable/ic_info"
            app:iconTint="#FFFFFF"
            app:backgroundTint="?attr/colorAccent"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_profile_close"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/profile_close_btn"
            android:textColor="@color/highContrast"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
