<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_timeline_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_footer_actions"
        android:layout_alignParentTop="true"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_badge_neutral" />

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/iv_timeline_header_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_shield"
                app:tint="#F85149"
                android:background="@drawable/bg_investigation_score_ring"
                android:padding="7dp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_timeline_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incident Timeline &amp; AI Audit"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC" />

                <TextView
                    android:id="@+id/tv_timeline_header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chronological Malware Forensic Analysis"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close_timeline"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="#94A3B8"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Dialog" />
        </LinearLayout>

        <!-- Monospace IOC / Source App Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_investigation_ioc_container"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tv_timeline_target_ioc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#38BDF8"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:ellipsize="middle"
                android:textIsSelectable="true"
                tools:text="com.suspicious.malware (App)" />

            <TextView
                android:id="@+id/tv_timeline_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THREAT DETECTED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/badge_pill_bg"
                app:backgroundTint="#F85149"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- AI FORENSIC AUDIT SECTION (Explains the timeline in plain language)   -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E293B"
            app:cardBackgroundColor="#0F172A"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- AI Card Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🤖 AI Forensic Timeline Audit"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#38BDF8" />

                    <TextView
                        android:id="@+id/tv_ai_audit_score_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIRMED MALICIOUS (95%)"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/badge_pill_bg"
                        app:backgroundTint="#F85149"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_ai_audit"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="true"
                    android:progressTint="#38BDF8"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- AI Timeline Narrative Explanation -->
                <TextView
                    android:id="@+id/tv_ai_timeline_narrative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0"
                    android:lineSpacingMultiplier="1.25"
                    tools:text="At 16:04:12, com.suspicious.app initiated an outbound connection toward a known C2 endpoint. Threat intelligence feeds flagged the traffic as high-risk Trojan activity, triggering an automatic firewall block and quarantine isolation within 1.2s." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E293B"
                    android:layout_marginVertical="10dp" />

                <!-- 2x2 Grid of Key Incident Findings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ATTACK VECTOR"
                            android:textSize="9sp"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tv_ai_attack_vector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Command &amp; Control (C2)"
                            android:textSize="11sp"
                            android:textColor="#F1F5F9"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BLAST RADIUS"
                            android:textSize="9sp"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tv_ai_blast_radius"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contained (0 Bytes Exfiltrated)"
                            android:textSize="11sp"
                            android:textColor="#3FB950"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MITRE ATT&amp;CK"
                            android:textSize="9sp"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tv_ai_mitre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T1071.004 (DNS Communication)"
                            android:textSize="11sp"
                            android:textColor="#38BDF8"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTAINMENT STATUS"
                            android:textSize="9sp"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tv_ai_containment_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blocked &amp; Quarantined"
                            android:textSize="11sp"
                            android:textColor="#E3B341"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E293B"
                    android:layout_marginVertical="8dp" />

                <!-- AI Remediation Guidance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 AI ACTIONABLE GUIDANCE:"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8"
                    android:layout_marginBottom="2dp"
                    tools:ignore="SmallSp" />

                <TextView
                    android:id="@+id/tv_ai_remediation_guidance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    tools:text="Keep the application quarantined. Do not release execution rights. Revoke background network access and perform a device full scan." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- MICROSOFT DEFENDER STYLE FORENSIC EVIDENCE & ENTITIES SECTION          -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_defender_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E293B"
            app:cardBackgroundColor="#0F172A"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔬 Forensic Evidence &amp; Artifacts"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#38BDF8" />

                    <TextView
                        android:id="@+id/tv_evidence_total_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 ARTIFACTS VERIFIED"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/badge_pill_bg"
                        app:backgroundTint="#0284C7"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        tools:ignore="SmallSp" />
                </LinearLayout>

                <!-- Impacted Entity Summary Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#0A0F1D"
                    android:padding="10dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IMPACTED ENTITIES"
                            android:textSize="9sp"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tv_evidence_device_entity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device: Android 11 • UID 1000"
                            android:textSize="11sp"
                            android:textColor="#E2E8F0"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERDICT STATUS"
                            android:textSize="9sp"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            tools:ignore="SmallSp" />

                        <TextView
                            android:id="@+id/tv_evidence_verdict_entity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remediated (Blocked)"
                            android:textSize="11sp"
                            android:textColor="#3FB950"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dynamic Evidence List Container -->
                <LinearLayout
                    android:id="@+id/ll_evidence_artifacts_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- CHRONOLOGICAL EVENT SEQUENCE SECTION                                  -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHRONOLOGICAL INCIDENT TIMELINE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:letterSpacing="0.08"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Container for Timeline Node Items -->
        <LinearLayout
            android:id="@+id/ll_timeline_events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- PINNED DOCKED FOOTER ACTIONS (Always accessible)                       -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_footer_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#0A0F1D"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_ai_report"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="📋 Copy Report"
                android:textSize="12sp"
                android:textColor="#38BDF8"
                app:strokeColor="#38BDF8"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timeline_deep_investigate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="🔍 Investigate"
                android:textSize="12sp"
                android:textColor="#A855F7"
                app:strokeColor="#A855F7"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_timeline_block_rule"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="🛡️ Block"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#F85149"
                app:cornerRadius="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
