<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:nextFocusDown="@id/expand_button"
    android:background="@drawable/payload_bubble_bg"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/header_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/direction_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill_tx"
            android:textColor="@color/badgeTxFg"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp"
            tools:text="TX" />

        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            tools:text="#1 11:02:03.154 — 120 B" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/jwt_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JWT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/protobuf_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doh_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DoH"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/badgeActiveFg"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/curl_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cURL"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/badgeProtoFg"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_resend_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="6dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REPEAT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimaryLight"
            android:visibility="gone"
            tools:visibility="visible"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="2dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_content_copy_small"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/colorTabText"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/export_button"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2dp"
            android:paddingHorizontal="2dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_save_alt_small"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/colorTabText"
            style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/dump_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/payload_box_inner_bg"
        android:padding="8dp">

        <TextView
            android:id="@+id/dump"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="true"
            android:fontFamily="@font/sourcecodepro_regular"
            android:textDirection="ltr"
            android:textSize="10sp"
            android:focusable="true"
            tools:text="GET / HTTP/1.1\nHost: example.org\nAccept: */*"/>
    </RelativeLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/expand_button"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingVertical="0dp"
        android:paddingHorizontal="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:layout_gravity="end"
        app:icon="@drawable/ic_expand_more"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/colorTabText"
        style="@style/Widget.MaterialComponents.Button.TextButton" />
</LinearLayout>
