<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_badge_neutral" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bolt"
                app:tint="@color/colorSecondary"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Security Audit &amp; Flow Analysis"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/metricTextPrimary" />

                <TextView
                    android:id="@+id/tv_flow_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/metricTextSecondary"
                    tools:text="142.250.190.46:443 (Google LLC)" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_flow_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE EXPERT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:background="@drawable/badge_pill_bg"
                android:backgroundTint="@color/cardBorderSubtle"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Threat Verdict Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorderSubtle"
            app:cardBackgroundColor="@color/cardWorkbenchBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tv_threat_prob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THREAT PROB"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/metricTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/cardBorderSubtle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">

                    <TextView
                        android:id="@+id/tv_flow_verdict"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evaluating flow..."
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/metricTextPrimary" />

                    <TextView
                        android:id="@+id/tv_flow_classification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Checking transfer asymmetry, port anomalies and host reputation."
                        android:textSize="11sp"
                        android:textColor="@color/metricTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App Intelligence & Provenance Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPLICATION INTELLIGENCE &amp; ORIGIN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/metricTextSecondary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_app_intelligence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorderSubtle"
            app:cardBackgroundColor="@color/cardWorkbenchBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_audit_app_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_apps"
                        android:contentDescription="App Icon"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_audit_app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Name"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/metricTextPrimary" />

                        <TextView
                            android:id="@+id/tv_audit_app_pkg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="com.example.app"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="@color/metricTextSecondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_audit_app_provenance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play Store"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/badge_pill_bg"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_audit_app_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/metricTextSecondary"
                    android:text="Risk Score: 0 • Permissions: Verified" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Behavioral Signals Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEHAVIORAL SIGNALS &amp; TELEMETRY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/metricTextSecondary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorderSubtle"
            app:cardBackgroundColor="@color/cardWorkbenchBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Metric 1: Transfer Ratio / Exfiltration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transfer Asymmetry (TX vs RX)"
                        android:textSize="12sp"
                        android:textColor="@color/metricTextPrimary" />

                    <TextView
                        android:id="@+id/tv_signal_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balanced"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cardBorderSubtle"
                    android:layout_marginVertical="4dp" />

                <!-- Metric 2: Destination Port & Protocol -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Port &amp; Protocol Standard"
                        android:textSize="12sp"
                        android:textColor="@color/metricTextPrimary" />

                    <TextView
                        android:id="@+id/tv_signal_port"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standard HTTPS (443)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cardBorderSubtle"
                    android:layout_marginVertical="4dp" />

                <!-- Metric 3: Host & ASN Reputation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Infrastructure / ASN Trust"
                        android:textSize="12sp"
                        android:textColor="@color/metricTextPrimary" />

                    <TextView
                        android:id="@+id/tv_signal_asn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Major Cloud Provider"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cardBorderSubtle"
                    android:layout_marginVertical="4dp" />

                <!-- Metric 4: MITRE ATT&CK Mapping -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MITRE ATT&amp;CK Mapping"
                        android:textSize="12sp"
                        android:textColor="@color/metricTextPrimary" />

                    <TextView
                        android:id="@+id/tv_signal_mitre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="T1071 (Web Protocols)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3-Bullet AI Security Verdict (Structured Offline & Online) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI SECURITY VERDICT &amp; FORENSIC INTEL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/metricTextSecondary"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorSecondary"
            app:cardBackgroundColor="@color/cardWorkbenchBg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_endpoint_identity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/metricTextPrimary"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="8dp"
                    android:text="🌐 Endpoint: Resolving infrastructure..." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cardBorderSubtle"
                    android:layout_marginVertical="4dp" />

                <TextView
                    android:id="@+id/tv_connection_intent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/metricTextPrimary"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginBottom="8dp"
                    android:text="📊 Intent: Assessing socket pattern..." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/cardBorderSubtle"
                    android:layout_marginVertical="4dp" />

                <TextView
                    android:id="@+id/tv_action_recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/metricTextPrimary"
                    android:lineSpacingMultiplier="1.3"
                    android:text="⚠️ Recommendation: Formulating action..." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Reasoning Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORENSIC REASONING &amp; FINDINGS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/metricTextSecondary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorderSubtle"
            app:cardBackgroundColor="@color/cardWorkbenchBg">

            <TextView
                android:id="@+id/tv_flow_reasoning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/metricTextSecondary"
                tools:text="Standard CDN telemetry flow. Communication pattern matches legitimate mobile API backend." />
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive AI Rule Action Button (visible only when AI verdict includes RULE_ACTION tag) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rule_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:text="🚫 Apply AI Recommended Rule"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="8dp"
            app:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_block_firewall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="🛡️ Block in Firewall"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#EF4444"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close_flow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Close"
                    android:textColor="@color/metricTextPrimary"
                    app:strokeColor="@color/cardBorderSubtle"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Deep Investigation (OTX & Threat Intel) Action Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_investigate_flow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#0284C7"
                app:cardBackgroundColor="#0C2038"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_search"
                        app:tint="#38BDF8"
                        android:background="@drawable/badge_pill_bg"
                        android:backgroundTint="#0369A1"
                        android:padding="5dp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍 Deep Threat Investigation"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#38BDF8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="AlienVault OTX • ThreatFox • VirusTotal Analysis"
                            android:textSize="10sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#38BDF8" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
