<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/cardBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cardBorderSubtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row: App Icon, App Name, Time, Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_browser_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_language"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_browser_app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/metricTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Google Chrome" />

            <TextView
                android:id="@+id/tv_log_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/metricTextSecondary"
                android:textSize="10sp"
                tools:text="23:55:12" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_active"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/badgeActiveFg"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="DECRYPTED" />
        </LinearLayout>

        <!-- Decrypted Section View -->
        <LinearLayout
            android:id="@+id/layout_decrypted_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_http_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_pill_tx"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/badgeTxFg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="GET" />

                <TextView
                    android:id="@+id/tv_http_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/badge_pill_active"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/badgeActiveFg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="200 OK" />

                <TextView
                    android:id="@+id/tv_http_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/metricTextPrimary"
                    android:textSize="12sp"
                    tools:text="https://www.google.com/search?q=android" />
            </LinearLayout>

            <!-- Decoded Payloads / Decoder Chips -->
            <LinearLayout
                android:id="@+id/layout_decoder_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_trackers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_pill_closed"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="TRACKERS (2)"
                    android:textColor="@color/warning"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chip_risk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_pill_closed"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="SUSPICIOUS"
                    android:textColor="@color/danger"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chip_https"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_pill_rx"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="HTTPS"
                    android:textColor="@color/badgeRxFg"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chip_doh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_pill_active"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="DoH (DNS)"
                    android:textColor="@color/badgeActiveFg"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chip_proto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/badge_pill_closed"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Protobuf"
                    android:textColor="@color/colorAccent"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/chip_jwt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_pill_closed"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="JWT Token"
                    android:textColor="@color/colorPrimary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Encrypted Section View -->
        <LinearLayout
            android:id="@+id/layout_encrypted_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/badgeClosedFg" />

                <TextView
                    android:id="@+id/tv_encrypted_proto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/badgeClosedFg"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="TLSv1.3 (Port 443)" />

                <TextView
                    android:id="@+id/tv_sni_domain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/metricTextPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="SNI: www.google.com" />
            </LinearLayout>

            <!-- Encrypted Stream Box -->
            <TextView
                android:id="@+id/tv_encrypted_hex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/payload_box_inner_bg"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="@color/metricTextSecondary"
                android:textSize="10sp"
                tools:text="17 03 03 00 80 a4 f1 9e 3d 0b 4a 72 8f 1c 3e\n[ENCRYPTED APPLICATION DATA STREAM: 15.7 KB]" />
        </LinearLayout>

        <!-- Bottom info line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_bytes_transferred"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/metricTextSecondary"
                android:textSize="10sp"
                tools:text="Sent: 1.2 KB  Rcvd: 14.5 KB" />

            <TextView
                android:id="@+id/tv_tap_inspect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Tap to inspect"
                android:textColor="@color/colorPrimary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
