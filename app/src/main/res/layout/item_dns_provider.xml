<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_dns_provider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cardBorder"
    app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Provider Name, Category Pill, Latency Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rb_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_provider_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="?android:attr/textColorPrimary"
                        tools:text="Quad9 Secure" />

                    <TextView
                        android:id="@+id/tv_provider_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_badge_neutral"
                        tools:text="Security"
                        tools:backgroundTint="#10B981" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_provider_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Blocks malware, phishing, and spyware using global threat intelligence." />
            </LinearLayout>

            <!-- Latency Pill Indicator -->
            <TextView
                android:id="@+id/tv_provider_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_neutral"
                tools:text="18 ms"
                tools:backgroundTint="#10B981" />
        </LinearLayout>

        <!-- Bottom Tags Row: IP badges & feature chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_provider_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorSecondary"
                android:background="@drawable/bg_badge_neutral"
                android:backgroundTint="#20808080"
                tools:text="9.9.9.9" />

            <TextView
                android:id="@+id/tv_provider_ipv6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:background="@drawable/bg_badge_neutral"
                android:backgroundTint="#20808080"
                android:text="IPv6" />

            <TextView
                android:id="@+id/tv_badge_doh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#6366F1"
                android:background="@drawable/bg_badge_neutral"
                android:backgroundTint="#256366F1"
                android:text="DoH" />

            <TextView
                android:id="@+id/tv_badge_adblock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#EC4899"
                android:background="@drawable/bg_badge_neutral"
                android:backgroundTint="#25EC4899"
                android:text="Shield" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
