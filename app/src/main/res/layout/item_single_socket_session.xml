<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/telemetry_widget_bg"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="10dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/socket_endpoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorPrimary"
            tools:text=":54124 → :443" />

        <TextView
            android:id="@+id/socket_proto_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill_proto"
            android:textColor="@color/badgeProtoFg"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="TLS" />

        <TextView
            android:id="@+id/socket_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_pill_active"
            android:textColor="@color/badgeActiveFg"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            tools:text="ESTABLISHED" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/socket_traffic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="@color/metricTextSecondary"
            tools:text="↑ 1.2 KB · ↓ 4.5 KB" />

        <TextView
            android:id="@+id/socket_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/metricTextSecondary"
            tools:text="1.2 s · 09:37:12" />
    </LinearLayout>
</LinearLayout>
