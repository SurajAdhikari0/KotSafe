<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- App Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="@string/wifi_security_title"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationContentDescription="Back" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Permission Needed Notice Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_permission_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#F59E0B"
                app:cardBackgroundColor="#15F59E0B"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_exclamation_triangle_solid"
                        app:tint="#F59E0B"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_permission_notice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="Grant Location/Nearby permission to reveal exact Wi-Fi SSID and AP hardware details." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant_permission"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minHeight="0dp"
                        android:textSize="11sp"
                        android:text="Grant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Wi-Fi Identity Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:id="@+id/wifi_icon_container"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_badge_neutral"
                            android:backgroundTint="#150072FF">

                            <ImageView
                                android:id="@+id/iv_wifi_status_icon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_wifi"
                                app:tint="#0072FF"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_wifi_ssid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorPrimary"
                                tools:text="Home_Network_5G" />

                            <TextView
                                android:id="@+id/tv_wifi_bssid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textColor="?android:attr/textColorSecondary"
                                tools:text="BSSID: 74:83:C2:41:20:9B" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_wifi_grade_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_solid"
                            android:backgroundTint="#10B981"
                            tools:text="GRADE A" />
                    </LinearLayout>

                    <!-- Security Rating Summary -->
                    <TextView
                        android:id="@+id/tv_wifi_security_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:padding="10dp"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:background="@drawable/bg_badge_neutral"
                        android:backgroundTint="#1510B981"
                        tools:text="Secure Network: Protected by WPA3/WPA2 authentication with robust AES encryption." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1: Security & Protocol Analysis -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Security &amp; Encryption Analysis"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="10dp" />

                    <!-- Security Standard Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_security_type" />

                        <TextView
                            android:id="@+id/tv_val_security_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="WPA2-PSK (AES-CCMP)" />
                    </LinearLayout>

                    <!-- Captive Portal Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="Captive Portal" />

                        <TextView
                            android:id="@+id/tv_val_captive_portal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#10B981"
                            tools:text="Clean (None Detected)" />
                    </LinearLayout>

                    <!-- Rogue AP / MITM Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="Rogue AP / MITM" />

                        <TextView
                            android:id="@+id/tv_val_mitm_risk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#10B981"
                            tools:text="Low Risk (Encrypted)" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Nearby Wi‑Fi Map -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Nearby Wi‑Fi Map"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_wifi_map_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 networks"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wifi_map_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Wireless & Signal Quality -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wireless Hardware &amp; Signal"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="10dp" />

                    <!-- Signal Strength Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_signal_strength" />

                        <TextView
                            android:id="@+id/tv_val_signal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="-52 dBm (96%)" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pb_signal_meter"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginVertical="6dp"
                        android:max="100"
                        android:progress="96"
                        android:progressTint="#10B981" />

                    <!-- Frequency Band -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_frequency" />

                        <TextView
                            android:id="@+id/tv_val_frequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="5.18 GHz (5 GHz Band • Ch 36)" />
                    </LinearLayout>

                    <!-- Link Speed -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_link_speed" />

                        <TextView
                            android:id="@+id/tv_val_link_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="866 Mbps" />
                    </LinearLayout>

                    <!-- Wi-Fi Standard -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="Wi-Fi Generation" />

                        <TextView
                            android:id="@+id/tv_val_wifi_standard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="Wi-Fi 6 (802.11ax)" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Network & Gateway IP Configuration -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder"
                app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Network Routing &amp; IP Config"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginBottom="10dp" />

                    <!-- Local IP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_local_ip" />

                        <TextView
                            android:id="@+id/tv_val_local_ip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="192.168.1.105" />
                    </LinearLayout>

                    <!-- Gateway Router -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_gateway" />

                        <TextView
                            android:id="@+id/tv_val_gateway"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="192.168.1.1" />
                    </LinearLayout>

                    <!-- Subnet Mask -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="Subnet Prefix" />

                        <TextView
                            android:id="@+id/tv_val_subnet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="255.255.255.0 (/24)" />
                    </LinearLayout>

                    <!-- DHCP DNS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/wifi_dns_servers" />

                        <TextView
                            android:id="@+id/tv_val_dns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="192.168.1.1, 8.8.8.8" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wifi_refresh"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/wifi_refresh"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="16dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wifi_shield"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/wifi_shield_now"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_shield"
                    app:iconSize="16dp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
