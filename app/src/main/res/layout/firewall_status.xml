<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/firewall_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="84dp"
        android:paddingHorizontal="16dp">

        <!-- ===================================================================
             1. CYBER SHIELD HERO POWER CENTERPIECE
             =================================================================== -->
        <FrameLayout
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp">

            <!-- Outer Pulse Radar Ring (animated) -->
            <View
                android:id="@+id/shield_pulse_ring"
                android:layout_width="216dp"
                android:layout_height="216dp"
                android:layout_gravity="center"
                android:background="@drawable/firewall_pulse_ring"
                android:alpha="0.45" />

            <!-- Concentric Middle Telemetry Ring -->
            <View
                android:id="@+id/shield_middle_ring"
                android:layout_width="184dp"
                android:layout_height="184dp"
                android:layout_gravity="center"
                android:background="@drawable/firewall_middle_ring" />

            <!-- Main Interactive Shield Toggle Button with Live Throughput HUD -->
            <FrameLayout
                android:id="@+id/shield_toggle_btn"
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_gravity="center"
                android:background="@drawable/firewall_shield_circle_bg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:elevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_shield"
                        tools:tint="#00E5FF" />

                    <TextView
                        android:id="@+id/hero_throughput_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        android:textColor="#FFFFFF"
                        tools:text="14.2 KB/s" />

                    <TextView
                        android:id="@+id/hero_throughput_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="#94A3B8"
                        tools:text="LIVE THROUGHPUT" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Status Posture Pill Badge -->
        <LinearLayout
            android:id="@+id/posture_badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:background="@drawable/posture_pill_bg"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/posture_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_circle_bg" />

            <TextView
                android:id="@+id/status_posture_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/ok"
                tools:text="ACTIVE ENFORCEMENT" />
        </LinearLayout>

        <!-- Main Status Title -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:gravity="center"
            tools:text="@string/firewall_is_enabled" />

        <!-- Tap Hint / Subtitle -->
        <TextView
            android:id="@+id/shield_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Tap shield to toggle real-time firewall protection"
            android:textSize="12sp"
            android:alpha="0.6" />

        <!-- Mode Indicator Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mode_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/cardBackground"
            app:strokeColor="@color/cardBorderSubtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/mode_info_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_filter"
                    app:tint="?attr/colorAccent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mode_info_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="Mode: Dynamic Threat Blocklist" />

                    <TextView
                        android:id="@+id/mode_info_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:alpha="0.65"
                        android:text="Blocks malicious IOCs, malware domains &amp; custom rules" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_switch_mode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="14dp"
                    android:text="Change"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    app:strokeColor="@color/colorAccent"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================================================================
             2. METRICS ANALYTICS 2x2 GRID (No black gaps, unified card design)
             =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Inspected & Blocked Connections -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Connections Checked -->
                <com.google.android.material.card.MaterialCardView
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/cardBackground"
                    app:strokeColor="@color/cardBorderSubtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:layout_margin="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/rounded_surface_secondary">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_stacked_bar_chart"
                                    app:tint="?attr/colorAccent" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="INSPECTED"
                                android:alpha="0.75" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/num_checked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="1.2k" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:alpha="0.55"
                            android:text="Live Packet Stream" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Connections Blocked -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/show_connections"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/cardBackground"
                    app:strokeColor="@color/warning">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:layout_margin="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/badge_pill_blocked">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_block"
                                    app:tint="@color/warning" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="BLOCKED"
                                android:textColor="@color/warning" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/num_blocked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/warning"
                            tools:text="48" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            android:text="Tap to view logs →" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Row 2: Configured Rules & Last Block Event -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Configured Rules -->
                <com.google.android.material.card.MaterialCardView
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/cardBackground"
                    app:strokeColor="@color/cardBorderSubtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:layout_margin="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/rounded_surface_secondary">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_shield"
                                    app:tint="?attr/colorAccent" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="RULES"
                                android:alpha="0.75" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/num_rules"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="21" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:alpha="0.55"
                            android:text="Active Firewall Rules" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Last Block Timestamp -->
                <com.google.android.material.card.MaterialCardView
                    android:clickable="false"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/cardBackground"
                    app:strokeColor="@color/cardBorderSubtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:layout_margin="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/rounded_surface_secondary">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_history"
                                    app:tint="?attr/colorAccent" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:text="LAST EVENT"
                                android:alpha="0.75" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/last_block"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="13:04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            android:alpha="0.55"
                            android:text="Recent Block Time" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================================================================
             3. DEFENSE POLICY & ISOLATION SETTINGS CARD
             =================================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/cardBackground"
            app:strokeColor="@color/cardBorderSubtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEFENSE POLICY &amp; SECURITY CONTROLS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="?attr/colorAccent"
                    android:layout_marginBottom="12dp" />

                <!-- Auto-Block Untrusted New Apps -->
                <LinearLayout
                    android:id="@+id/row_block_new_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_apps"
                        app:tint="?attr/colorAccent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="@string/block_new_apps" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:alpha="0.65"
                            android:text="Automatically block network for newly installed APKs" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_block_new_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/drawerSeparatorColor"
                    android:layout_marginVertical="6dp" />

                <!-- SmartScreen Browser Interception -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/ok" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="SmartScreen Browser Defense" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:alpha="0.65"
                            android:text="Local proxy block page active on 127.0.0.1:8080" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/ok" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>