<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:background="@drawable/rounded_bg">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#44888888" />

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_pref_search"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Settings &amp; Features"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find any security rule, network option or tool"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Input Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33888888"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/et_settings_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search AI, Firewall, DNS, TLS, SOCKS5..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary" />

            <ImageView
                android:id="@+id/iv_clear_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2dp"
                android:src="@drawable/ic_close"
                app:tint="?android:attr/textColorSecondary"
                android:visibility="gone"
                android:contentDescription="Clear" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Filter Suggestion Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#2200E5FF"
                android:text="🤖 AI Defense"
                android:textSize="12sp"
                android:textColor="#00E5FF" />

            <TextView
                android:id="@+id/chip_firewall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#228E2DE2"
                android:text="🛡️ Firewall"
                android:textSize="12sp"
                android:textColor="#C084FC" />

            <TextView
                android:id="@+id/chip_dns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#220575E6"
                android:text="⚡ DNS / DoH"
                android:textSize="12sp"
                android:textColor="#60A5FA" />

            <TextView
                android:id="@+id/chip_tls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#22DA22FF"
                android:text="🔒 TLS Decrypt"
                android:textSize="12sp"
                android:textColor="#F472B6" />

            <TextView
                android:id="@+id/chip_socks5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#2200F260"
                android:text="📡 SOCKS5 Proxy"
                android:textSize="12sp"
                android:textColor="#4ADE80" />

            <TextView
                android:id="@+id/chip_backup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#22F2994A"
                android:text="💾 Backup &amp; Restore"
                android:textSize="12sp"
                android:textColor="#FB923C" />

            <TextView
                android:id="@+id/chip_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="#2226D0CE"
                android:text="🌍 Language"
                android:textSize="12sp"
                android:textColor="#2DD4BF" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tv_no_results"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No matching settings found"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <!-- Results Recycler List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings_search_results"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="vertical" />

</LinearLayout>
