<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundColor"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:alpha="0.4"
        android:background="@drawable/badge_pill_closed" />

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_shield_check"
            app:tint="@color/p2pAccent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Residential Shield &amp; Leak Audit"
                android:textColor="@color/metricTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zero-Trust Egress IP &amp; Location Verification"
                android:textColor="@color/metricTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_leak_dialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/metricTextSecondary" />
    </LinearLayout>

    <!-- LOADING / PROGRESS STATE -->
    <LinearLayout
        android:id="@+id/layout_leak_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="28dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/p2pAccent" />

        <TextView
            android:id="@+id/tv_leak_progress_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Probing P2P egress gateway..."
            android:textColor="@color/metricTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Testing direct socket vs. SOCKS5 exit tunnel..."
            android:textColor="@color/metricTextSecondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- RESULTS CONTENT -->
    <LinearLayout
        android:id="@+id/layout_leak_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Verdict Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_verdict_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cardBorderSubtle"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_verdict_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_pill_active"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🟢 100% RESIDENTIAL SHIELD ACTIVE"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_verdict_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Your travel location and ISP are completely hidden. External services see your home residential connection."
                    android:textColor="@color/metricTextPrimary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Detailed Audit Grid -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/cardBackground"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cardBorderSubtle"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Visible Public Egress IP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PUBLIC EGRESS IP (SEEN BY APPS)"
                            android:textColor="@color/p2pAccent"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_egress_ip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="122.160.45.12"
                            android:textColor="@color/metricTextPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_egress_isp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Airtel Broadband • abts-north-delhi.airtel.in"
                            android:textColor="@color/metricTextSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_copy_egress_ip"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@drawable/ic_content_copy"
                        app:tint="@color/metricTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/cardBorderSubtle" />

                <!-- ISP Classification -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ISP Fingerprint Type"
                        android:textColor="@color/metricTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_residential_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏡 Residential (Home ISP)"
                        android:textColor="#00E676"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/cardBorderSubtle" />

                <!-- Location / Edge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Visible Location"
                        android:textColor="@color/metricTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_egress_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="India (Delhi Edge)"
                        android:textColor="@color/metricTextPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/cardBorderSubtle" />

                <!-- Real Device IP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Real Device Physical IP"
                        android:textColor="@color/metricTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_direct_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masked &amp; Hidden ✅"
                        android:textColor="#00E676"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/cardBorderSubtle" />

                <!-- VPN Capture Engine -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VPN Engine Capture"
                        android:textColor="@color/metricTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_vpn_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active (All Apps Tunneled) ✅"
                        android:textColor="#00E676"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/cardBorderSubtle" />

                <!-- IPv6 & DNS Protection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IPv6 &amp; DNS Privacy"
                        android:textColor="@color/metricTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_dns_ipv6_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero Leaks Detected ✅"
                        android:textColor="#00E676"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Diagnostic Warning / Recommendation (if any) -->
        <TextView
            android:id="@+id/tv_diagnostic_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Audit complete at 10:30:15 • SOCKS5 latency: 42ms"
            android:textColor="@color/metricTextSecondary"
            android:textSize="11sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_leak_killswitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#F59E0B"
                android:text="Kill-Switch"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingHorizontal="4dp"
                app:cornerRadius="10dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_leak_retest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/cardBackground"
                app:strokeColor="@color/p2pAccent"
                app:strokeWidth="1dp"
                android:text="Re-test"
                android:textColor="@color/p2pAccent"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_leak_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/p2pAccent"
                android:text="Done"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

