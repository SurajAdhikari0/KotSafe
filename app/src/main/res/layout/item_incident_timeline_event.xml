<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Timeline Indicator Column (Line + Dot + Line) -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/line_top"
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#334155" />

        <View
            android:id="@+id/dot_indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/status_circle_bg"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            app:backgroundTint="#38BDF8" />

        <View
            android:id="@+id/line_bottom"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#334155" />
    </LinearLayout>

    <!-- Event Content Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_investigation_card"
        android:padding="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#0F172A">

        <!-- Top Row: Badge + Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_event_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MALWARE DETECTED"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                tools:ignore="SmallSp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_event_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:fontFamily="monospace"
                tools:text="16:04:12" />
        </LinearLayout>

        <!-- Event Title -->
        <TextView
            android:id="@+id/tv_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            tools:text="Trojan C2 Beacon Initiated" />

        <!-- Event Detail -->
        <TextView
            android:id="@+id/tv_event_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:lineSpacingMultiplier="1.2"
            tools:text="App attempted outbound DNS lookup for command-and-control server." />

        <!-- Microsoft Defender Event Evidence Container -->
        <LinearLayout
            android:id="@+id/ll_event_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A0F1D"
            android:padding="8dp"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔬 EVIDENCE ARTIFACTS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8"
                    android:letterSpacing="0.05"
                    tools:ignore="SmallSp" />

                <TextView
                    android:id="@+id/tv_evidence_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARTIFACT DETECTED"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:background="#1E293B"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_event_evidence_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#CBD5E1"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                tools:text="• [NET] Remote: android-safebrowsing.google.com:443\n• [DGA] Shannon Entropy: 3.62" />
        </LinearLayout>

        <!-- Footer Meta Row (Mitre Technique & Risk Tag) -->
        <LinearLayout
            android:id="@+id/ll_event_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_event_mitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#38BDF8"
                android:background="@drawable/bg_investigation_ioc_container"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:fontFamily="monospace"
                android:layout_marginEnd="6dp"
                tools:text="MITRE: T1071.004"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/tv_event_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#F85149"
                android:textStyle="bold"
                tools:text="Risk 90/100"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
