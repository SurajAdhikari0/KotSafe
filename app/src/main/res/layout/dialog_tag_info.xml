<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- Badge preview header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tag_badge_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_bg"
                app:backgroundTint="#1E293B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="🔁 6 flows" />

            <TextView
                android:id="@+id/tag_target_subtitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:ellipsize="middle"
                android:singleLine="true"
                tools:text="api.whatsapp.com:443" />
        </LinearLayout>

        <!-- Tag Title -->
        <TextView
            android:id="@+id/tv_tag_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="10dp"
            tools:text="Parallel Sockets (Flows)" />

        <!-- Info Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/badge_pill_bg"
            app:backgroundTint="#0F172A"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_tag_what_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is this tag?"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_tag_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#F1F5F9"
                tools:text="This application opened 6 parallel network connections to this destination." />

            <View
                android:id="@+id/divider_why"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginVertical="10dp" />

            <TextView
                android:id="@+id/tv_tag_why_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Why are they merged?"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_tag_why_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="#CBD5E1"
                tools:text="Apps open multiple connections simultaneously to speed up downloads. Deduplicating them keeps your feed clean." />

            <LinearLayout
                android:id="@+id/container_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E293B"
                    android:layout_marginVertical="10dp" />

                <TextView
                    android:id="@+id/tv_tag_reason_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Security Classification"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#F85149"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_tag_reason_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#FCA5A5"
                    tools:text="Malware / C2 Botnet server" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tip Box -->
        <TextView
            android:id="@+id/tv_tag_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:lineSpacingExtra="2dp"
            android:text="💡 Tip: Tap the connection card anytime to view individual socket details, data transfer, and active duration." />

    </LinearLayout>
</ScrollView>
