<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#306366F1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pref_vault"
                app:tint="@color/colorAccent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="PRIVACY &amp; TRUST VERIFIER"
                android:textAllCaps="true"
                android:textColor="@color/colorAccent"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap each core pledge to verify KotSafe's privacy standards:"
            android:textColor="@color/colorTabText"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/chk_privacy_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="100% On-Device: Packets never leave phone"
                android:textColor="@color/drawerItemColor"
                android:textSize="11.5sp"
                app:buttonTint="@color/colorAccent" />

            <CheckBox
                android:id="@+id/chk_privacy_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Zero Telemetry: No third-party trackers or profiling"
                android:textColor="@color/drawerItemColor"
                android:textSize="11.5sp"
                app:buttonTint="@color/colorAccent" />

            <CheckBox
                android:id="@+id/chk_privacy_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Offline Intelligence: AI &amp; scans run locally"
                android:textColor="@color/drawerItemColor"
                android:textSize="11.5sp"
                app:buttonTint="@color/colorAccent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/privacy_verdict_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/rounded_surface_secondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_solid"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/privacy_verdict_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Trust Verification: 100% Verified Private Enclave"
                android:textColor="@color/drawerItemColor"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
