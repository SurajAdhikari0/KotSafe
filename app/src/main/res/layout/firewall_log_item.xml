<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cardBorder"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: App Icon, Name, Service Badge, Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/log_app_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                tools:srcCompat="@drawable/sym_def_app_icon"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/log_app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Google Chrome" />

            <TextView
                android:id="@+id/log_service_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="SERVICE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:background="@drawable/bg_badge_service"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/log_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="14:52:10" />
        </LinearLayout>

        <!-- Action row: Action Badge & Policy Reason -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/log_action_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:lines="1"
                android:singleLine="true"
                android:background="@drawable/bg_nac_status_blocked"
                android:textColor="@color/danger"
                tools:text="BLOCKED" />

            <TextView
                android:id="@+id/log_reason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Wi-Fi Access Blocked" />

            <ImageView
                android:id="@+id/log_background_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_shield"
                app:tint="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="Background" />
        </LinearLayout>

        <!-- Destination and Protocols Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/log_destination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="connectivitycheck.gstatic.com:443" />

            <TextView
                android:id="@+id/log_proto_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:background="@drawable/bg_badge_neutral"
                tools:text="TCP" />

            <TextView
                android:id="@+id/log_network_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary"
                android:background="@drawable/bg_badge_neutral"
                tools:text="WIFI" />
        </LinearLayout>

        <!-- Hash & Threat IOC row -->
        <LinearLayout
            android:id="@+id/log_hash_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_neutral"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHA256: "
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/log_payload_hash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="9.5sp"
                android:fontFamily="monospace"
                android:textColor="?android:attr/textColorSecondary"
                android:singleLine="true"
                android:ellipsize="middle"
                tools:text="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" />

            <TextView
                android:id="@+id/btn_quick_vt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Analyze IOC"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
