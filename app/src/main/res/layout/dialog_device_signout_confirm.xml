<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/profile_dialog_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header Section with Warning Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Red Logout Warning Icon -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_profile_signout_btn">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_logout"
                app:tint="@color/profileDanger" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_modal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revoke Device Session"
                android:textColor="@color/profileTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sign out authorized hardware"
                android:textColor="@color/profileTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/profileCardBorder" />

    <!-- Prompt Message -->
    <TextView
        android:id="@+id/tv_modal_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="Are you sure you want to sign out and revoke cloud access for this device?"
        android:textColor="@color/profileTextSecondary"
        android:textSize="13sp" />

    <!-- Device Details Card Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_profile_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_profile_cyan_icon_bg">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_2fa_phone"
                app:tint="@color/profileAccent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_modal_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="OPPO CPH2263"
                android:textColor="@color/profileTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_modal_device_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Android 14 • Active Cloud Session"
                android:textColor="@color/profileTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Notice Warning Note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="Notice: Revoking this device will disconnect its Zero-Trust telemetry and P2P mesh relay until re-authenticated."
        android:textColor="@color/profileTextTertiary"
        android:textSize="11sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Cancel / Keep Connected Button -->
        <TextView
            android:id="@+id/btn_modal_cancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_profile_outline_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Keep Connected"
            android:textColor="@color/profileTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Confirm Sign Out Button -->
        <LinearLayout
            android:id="@+id/btn_modal_confirm_signout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_profile_signout_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_logout"
                app:tint="@color/profileDanger" />

            <TextView
                android:id="@+id/tv_modal_confirm_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Out Device"
                android:textColor="@color/profileDanger"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
