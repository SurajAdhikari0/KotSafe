<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Quick navigation banner to return to Connections -->
        <LinearLayout
            android:id="@+id/btn_return_to_connections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:background="@drawable/badge_pill_bg"
            app:backgroundTint="#0F172A"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#38BDF8" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="← Return to Connections"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTTP Repeater"
                android:textSize="11sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- REQUEST CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorder"
            app:cardBackgroundColor="@color/surfaceColor"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET &amp; METHOD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryLight"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <!-- Method & URL row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <Spinner
                        android:id="@+id/spinner_method"
                        android:layout_width="110dp"
                        android:layout_height="48dp"
                        android:background="@drawable/repeater_spinner_bg"
                        android:layout_marginEnd="8dp"
                        android:paddingHorizontal="4dp" />

                    <EditText
                        android:id="@+id/edit_url"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/repeater_input_bg"
                        android:hint="https://example.com/api"
                        android:inputType="textUri"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/highContrast"
                        android:textColorHint="#94A3B8"
                        android:singleLine="true" />

                </LinearLayout>

                <!-- Send button & progress indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="SEND REQUEST"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:icon="@drawable/ic_send"
                        app:iconTint="#FFFFFF"
                        app:iconGravity="textStart"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/colorPrimaryLight" />

                    <ProgressBar
                        android:id="@+id/progress_loading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="10dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- Request Sub-Tabs (Headers / Body) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_headers"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="HEADERS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        app:cornerRadius="18dp"
                        android:layout_marginEnd="6dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_body"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="BODY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/metricTextSecondary"
                        app:cornerRadius="18dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_fuzz"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🤖 AI Payloads"
                        android:textSize="11sp"
                        android:textColor="#38BDF8"
                        app:icon="@drawable/ic_bolt"
                        app:iconTint="#38BDF8"
                        app:iconSize="14dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_action_helper"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Prettify JSON"
                        android:textSize="10sp"
                        android:paddingHorizontal="8dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton" />

                </LinearLayout>

                <!-- Headers Section -->
                <LinearLayout
                    android:id="@+id/layout_headers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/edit_headers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="4"
                        android:maxLines="10"
                        android:gravity="top|start"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:padding="10dp"
                        android:textColor="@color/highContrast"
                        android:textColorHint="#94A3B8"
                        android:background="@drawable/repeater_input_bg"
                        android:hint="Content-Type: application/json\nUser-Agent: KotSafe-Repeater\nAccept: */*" />

                </LinearLayout>

                <!-- Body Section -->
                <LinearLayout
                    android:id="@+id/layout_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/edit_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:maxLines="14"
                        android:gravity="top|start"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:padding="10dp"
                        android:textColor="@color/highContrast"
                        android:textColorHint="#94A3B8"
                        android:background="@drawable/repeater_input_bg"
                        android:hint="{\n  &quot;key&quot;: &quot;value&quot;\n}" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RESPONSE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorder"
            app:cardBackgroundColor="@color/surfaceColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESPONSE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryLight"
                        android:letterSpacing="0.08" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_response"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:visibility="visible"
                        style="@style/Widget.MaterialComponents.Button.TextButton" />

                </LinearLayout>

                <!-- Response Stats Bar (Status Code, Latency, Size) -->
                <LinearLayout
                    android:id="@+id/layout_response_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_response_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="200 OK"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/badgeActiveFg"
                        android:background="@drawable/badge_pill_active"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_response_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="124 ms"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/badgeProtoFg"
                        android:background="@drawable/badge_pill_proto"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_response_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.3 KB"
                        android:textSize="12sp"
                        android:textColor="@color/metricTextSecondary"
                        android:paddingHorizontal="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ai_explain_resp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🤖 AI Explain"
                        android:textSize="11sp"
                        android:textColor="#38BDF8"
                        app:icon="@drawable/ic_bolt"
                        app:iconTint="#38BDF8"
                        app:iconSize="13dp" />

                </LinearLayout>

                <!-- Response Sub-Tabs: Body, Headers, Raw -->
                <LinearLayout
                    android:id="@+id/layout_response_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_resp_body"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="BODY"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        app:cornerRadius="16dp"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_resp_headers"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="HEADERS"
                        android:textSize="10sp"
                        android:textColor="@color/metricTextSecondary"
                        app:cornerRadius="16dp"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_resp_raw"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="RAW"
                        android:textSize="10sp"
                        android:textColor="@color/metricTextSecondary"
                        app:cornerRadius="16dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layout_resp_empty"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_send"
                        app:tint="@color/lightGray"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No response yet"
                        android:textStyle="bold"
                        android:textColor="@color/lightGray"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit the request parameters and tap Send"
                        android:textColor="@color/lightGray"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Response Content Box -->
                <HorizontalScrollView
                    android:id="@+id/scroll_response_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_response_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="140dp"
                        android:padding="10dp"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:textIsSelectable="true"
                        android:textColor="@color/highContrast"
                        android:background="@drawable/repeater_input_bg" />

                </HorizontalScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
