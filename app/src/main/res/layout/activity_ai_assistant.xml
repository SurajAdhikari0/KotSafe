<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aiChatBackground">

    <!-- App Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorActionBar"
        android:elevation="4dp"
        app:titleTextColor="@android:color/white"
        app:subtitleTextColor="#C7D2FE"
        app:title="KotSafe AI Assistant"
        app:subtitle="Security Advisor &amp; Protocol Analyst" />

    <!-- Privacy Banner / Access Notice -->
    <LinearLayout
        android:id="@+id/banner_privacy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aiChatBannerBg"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_privacy_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/aiChatBannerIcon" />

        <TextView
            android:id="@+id/tv_active_permissions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Privacy Gate Active • Granular permissions enforced"
            android:textColor="@color/aiChatBannerText"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_config_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textColor="@color/aiChatBannerIcon"
            android:textStyle="bold"
            android:textSize="12sp"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/btn_dismiss_banner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/aiChatBannerText"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Dismiss" />
    </LinearLayout>

    <!-- Quick Prompt Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@color/aiChatBackground">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_quick_prompts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_security_audit"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Security Audit"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="#0EA5E9"
                app:chipStrokeWidth="1.5dp"
                android:textColor="#38BDF8" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_analyze_traffic"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Analyze Traffic"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_scan_malware"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦠 Malware Scan"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_threat_intel"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Threat Intel"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_setup_ai"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 Setup Free AI Keys"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_setup_firewall"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ How to Setup Firewall"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_setup_https"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 How to Decrypt HTTPS"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_explain_telemetry"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Live Telemetry &amp; Metrics"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_explain_repeater"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ What is HTTP Repeater?"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_explain_antivirus"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 Antivirus Deep Scan"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_explain_mitre"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ MITRE ATT&amp;CK Framework"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_explain_connections"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Active Connections"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_explain_p2p"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 P2P Exit Node &amp; Gateway"
                app:chipBackgroundColor="@color/aiChatChipBg"
                app:chipStrokeColor="@color/aiChatChipStroke"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/aiChatChipText" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:background="@color/aiChatBackground" />

    <!-- Thinking / Loading Indicator -->
    <LinearLayout
        android:id="@+id/layout_thinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:background="@color/aiChatInputBarBg">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tv_thinking_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="KotSafe AI is analyzing..."
            android:textColor="@color/aiChatInputHint"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/aiChatInputBarBg"
        android:elevation="6dp"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_prompt_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ai_chat_input_background"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="Ask KotSafe AI about features, status or attacks..."
            android:textColorHint="@color/aiChatInputHint"
            android:textColor="@color/aiChatInputText"
            android:textSize="14sp"
            android:maxLines="4" />

        <ImageButton
            android:id="@+id/btn_send_prompt"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            app:tint="@color/colorAccent"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
