<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Status Icon -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/step_status"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="14dp"
                android:background="@drawable/badge_pill_closed"
                android:backgroundTint="?android:attr/colorBackgroundFloating"
                android:src="@drawable/ic_pref_tls"
                app:tint="@color/colorPrimary"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Step Badge -->
        <TextView
            android:id="@+id/step_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#0EA5E9"
            android:background="@drawable/bg_badge_neutral"
            android:layout_marginBottom="8dp"
            tools:text="TLS DECRYPTION" />

        <!-- Title -->
        <TextView
            android:id="@+id/step_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/metricTextPrimary"
            android:textAlignment="center"
            android:layout_marginBottom="8dp"
            tools:text="HTTPS Decryption Setup" />

        <!-- Description / Instructions -->
        <TextView
            android:id="@+id/step_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/metricTextSecondary"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"
            tools:text="Install the companion MITM add-on to inspect cleartext HTTP/HTTPS traffic." />

        <!-- Feature Highlights / Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_details_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cardBorder"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_details_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/metricTextPrimary"
                    android:layout_marginBottom="6dp"
                    tools:text="What This Unlocks:" />

                <TextView
                    android:id="@+id/tv_details_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/metricTextSecondary"
                    tools:text="• Full HTTP URL and query parameter extraction\n• Formatted JSON and REST API request bodies\n• Authorization and Cookie header inspection" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Spacer to push buttons down if needed -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Optional Root / System Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_root_action"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="⚡ Install into System CA Store (Root)"
            android:textColor="#10B981"
            app:strokeColor="#10B981"
            app:cornerRadius="10dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Skip / Later Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/skip_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="@string/app_intro_skip_button"
            android:textColor="@color/metricTextSecondary"
            app:cornerRadius="10dp"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Primary Step Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/step_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:text="Get Started"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            tools:text="Install Add-on" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>