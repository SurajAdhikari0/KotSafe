<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#161B22"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="#30363D"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: Icon + Title + Close -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#F85149" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_forensic_filename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="threat_sample.apk"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_forensic_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MALWARE / DALVIK DROPPER"
                        android:textColor="#F85149"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_forensic_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_close"
                    app:tint="#8B949E"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#21262D" />

            <!-- Vault Containment Posture Badges -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VAULT CONTAINMENT POSTURE"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:background="#0D1117"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Encrypted Envelope: AES-256-GCM Authenticated (.kotvault)"
                    android:textColor="#58A6FF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚫 Execution Disabled: POSIX chmod 0600 (Stripped Executable Bits)"
                    android:textColor="#3FB950"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Network Quarantine: Egress Socket Sinkholed via Local VPN"
                    android:textColor="#D29922"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- File Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FORENSIC METADATA"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tv_forensic_size_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Size: 2.4 MB • Quarantined on Sep 16, 2026, 22:30"
                android:textColor="#C9D1D9"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_forensic_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="/storage/emulated/0/Download/payload.apk"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_forensic_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dynamic DexClassLoader detected inside hidden assets."
                android:textColor="#F0883E"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <!-- Cryptographic SHA-256 Box -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHA-256 FINGERPRINT"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0D1117"
                android:padding="10dp"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_forensic_sha256"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:ellipsize="middle"
                    android:maxLines="2" />

                <ImageView
                    android:id="@+id/btn_copy_forensic_hash"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_content_copy_small"
                    app:tint="#58A6FF"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy Hash" />
            </LinearLayout>

            <!-- Threat Intel Community Lookups -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMUNITY THREAT INTEL LOOKUP"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lookup_otx"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="OTX Pulse"
                    android:textSize="11sp"
                    app:strokeColor="#58A6FF"
                    android:textColor="#58A6FF"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lookup_bazaar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="MalwareBazaar"
                    android:textSize="10sp"
                    app:strokeColor="#3FB950"
                    android:textColor="#3FB950"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lookup_virustotal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="VirusTotal"
                    android:textSize="11sp"
                    app:strokeColor="#D29922"
                    android:textColor="#D29922" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#21262D" />

            <!-- Vault Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_forensic_restore"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Restore File"
                    android:textSize="12sp"
                    android:textColor="#C9D1D9"
                    app:strokeColor="#30363D"
                    android:layout_marginEnd="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_forensic_delete"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Shred &amp; Delete"
                    android:textSize="12sp"
                    app:backgroundTint="#DA3633" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
