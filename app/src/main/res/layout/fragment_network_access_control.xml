<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="56dp"
    android:scrollbars="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Responsive Centering Container (Caps max width on tablets & landscape) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="640dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 1. App Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/nac_app_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        tools:src="@drawable/ic_apps" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nac_app_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="Google Play services" />

                        <TextView
                            android:id="@+id/nac_package_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="com.google.android.gms (UID: 10151)" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Dynamic Firewall Status Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nac_firewall_banner_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder">

                <LinearLayout
                    android:id="@+id/nac_firewall_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/nac_banner_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/ok" />

                        <TextView
                            android:id="@+id/nac_banner_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="Firewall Active: Rules Enforced" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nac_banner_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="?android:attr/textColorSecondary"
                        tools:text="Granular network rules are actively enforced by KotSafe." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nac_btn_enable_firewall"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cornerRadius="18dp"
                        android:text="@string/nac_enable_firewall"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Granular Access Controls Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/cardBorder">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:text="NETWORK ACCESS PERMISSIONS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="?android:attr/textColorSecondary" />

                    <!-- 1. Wi-Fi Access -->
                    <LinearLayout
                        android:id="@+id/row_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_nac_icon_circle">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_wifi"
                                app:tint="?android:attr/textColorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nac_wifi_title"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/nac_status_wifi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1.5dp"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:background="@drawable/bg_nac_status_allowed"
                                    android:textColor="@color/ok"
                                    tools:text="Allowed" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/nac_wifi_desc"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/nac_switch_wifi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="?android:attr/listDivider" />

                    <!-- 2. Mobile Data Access -->
                    <LinearLayout
                        android:id="@+id/row_mobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_nac_icon_circle">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mobile"
                                app:tint="?android:attr/textColorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nac_mobile_title"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/nac_status_mobile"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1.5dp"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:background="@drawable/bg_nac_status_allowed"
                                    android:textColor="@color/ok"
                                    tools:text="Allowed" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/nac_mobile_desc"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/nac_switch_mobile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="?android:attr/listDivider" />

                    <!-- 3. Roaming Access -->
                    <LinearLayout
                        android:id="@+id/row_roaming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_nac_icon_circle">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_roaming"
                                app:tint="?android:attr/textColorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nac_roaming_title"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/nac_status_roaming"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1.5dp"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:background="@drawable/bg_nac_status_allowed"
                                    android:textColor="@color/ok"
                                    tools:text="Allowed" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/nac_roaming_desc"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/nac_switch_roaming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="?android:attr/listDivider" />

                    <!-- 4. Allow in Background -->
                    <LinearLayout
                        android:id="@+id/row_background"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_nac_icon_circle">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shield"
                                app:tint="?android:attr/textColorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nac_background_title"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/nac_status_background"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1.5dp"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:background="@drawable/bg_nac_status_allowed"
                                    android:textColor="@color/ok"
                                    tools:text="Allowed" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/nac_background_desc"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/nac_switch_background"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="70dp"
                        android:layout_marginEnd="16dp"
                        android:background="?android:attr/listDivider" />

                    <!-- 5. LAN Access -->
                    <LinearLayout
                        android:id="@+id/row_lan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_nac_icon_circle">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lan"
                                app:tint="?android:attr/textColorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/nac_lan_title"
                                    android:textSize="14.5sp"
                                    android:textStyle="bold"
                                    android:textColor="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/nac_status_lan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1.5dp"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:lines="1"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:background="@drawable/bg_nac_status_allowed"
                                    android:textColor="@color/ok"
                                    tools:text="Allowed" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/nac_lan_desc"
                                android:textSize="12sp"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/nac_switch_lan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Quick Action Buttons Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nac_btn_block_all"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        app:cornerRadius="12dp"
                        android:text="Block"
                        android:textSize="11.5sp"
                        android:maxLines="1"
                        android:textColor="@color/statusError"
                        app:icon="@drawable/ic_block"
                        app:iconSize="14dp"
                        app:iconPadding="4dp"
                        app:iconTint="@color/statusError"
                        app:strokeColor="@color/statusError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nac_btn_data_saver"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1.2"
                        android:layout_marginHorizontal="4dp"
                        android:paddingHorizontal="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        app:cornerRadius="12dp"
                        android:text="Data Saver"
                        android:textSize="11.5sp"
                        android:maxLines="1"
                        android:textColor="@color/badgeProtoFg"
                        app:strokeColor="@color/badgeProtoFg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nac_btn_allow_all"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        app:cornerRadius="12dp"
                        android:text="Allow"
                        android:textSize="11.5sp"
                        android:maxLines="1"
                        app:icon="@drawable/ic_check_solid"
                        app:iconSize="14dp"
                        app:iconPadding="4dp"
                        app:iconTint="@android:color/white" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/nac_quick_actions_note" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
