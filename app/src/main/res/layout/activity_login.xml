<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <!-- Logo and Brand Badge with Pulse Ring -->
            <FrameLayout
                android:id="@+id/frame_logo_container"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="8dp">

                <!-- Glowing Pulse Ring Behind Logo -->
                <View
                    android:id="@+id/view_pulse_ring"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/nav_logo_bg"
                    android:alpha="0.3"/>

                <FrameLayout
                    android:id="@+id/frame_logo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/nav_logo_bg"/>

                    <ImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="@string/app_name"/>
                </FrameLayout>
            </FrameLayout>

            <!-- Protection Status Pill (Instant Assurance on First Launch) -->
            <LinearLayout
                android:id="@+id/layout_protection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_solid"
                android:backgroundTint="#1F10B981"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/dot_protection_pulse"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_badge_solid"
                    android:backgroundTint="#10B981"/>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#10B981"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/tv_protection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/login_protection_active"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:letterSpacing="0.02"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_login_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/login_title"
                android:textColor="@color/highContrast"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"/>

            <TextView
                android:id="@+id/tv_login_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_subtitle"
                android:textColor="@color/metricTextSecondary"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"/>

            <!-- Rate limit warning banner (dynamically shown) -->
            <TextView
                android:id="@+id/tv_rate_limit_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_solid"
                android:backgroundTint="@color/danger"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Too many attempts. Cooldown active."/>

            <!-- Auth Required Notice Pill (Dynamic Pill when redirecting from P2P/Protected Features) -->
            <LinearLayout
                android:id="@+id/layout_auth_required_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge_solid"
                android:backgroundTint="#D97706"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#FFFFFF"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/tv_auth_required_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="You need to sign-in to use this feature"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SSO Social Logins Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_sso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/aboutCardBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Google SSO -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sso_google"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/sign_in_with_google"
                        android:textColor="@color/highContrast"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_sso_google"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@null"
                        app:backgroundTint="@color/cardBgSecondary"
                        app:strokeColor="@color/cardBorderSubtle"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"/>

                    <!-- GitHub SSO -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sso_github"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/sign_in_with_github"
                        android:textColor="@color/highContrast"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_sso_github"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@null"
                        app:backgroundTint="@color/cardBgSecondary"
                        app:strokeColor="@color/cardBorderSubtle"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"/>

                    <!-- Microsoft SSO -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sso_microsoft"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/sign_in_with_microsoft"
                        android:textColor="@color/highContrast"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_sso_microsoft"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@null"
                        app:backgroundTint="@color/cardBgSecondary"
                        app:strokeColor="@color/cardBorderSubtle"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Divider Row -->
            <LinearLayout
                android:id="@+id/layout_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/cardBorderSubtle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/or_continue_with_email"
                    android:textColor="@color/metricTextSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/cardBorderSubtle"/>
            </LinearLayout>

            <!-- Email & Password Form Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_email_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/aboutCardBg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Email Input Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/email_hint"
                        app:boxStrokeColor="@color/colorAccent"
                        app:hintTextColor="@color/colorAccent"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/highContrast"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/password_hint"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/metricTextSecondary"
                        app:boxStrokeColor="@color/colorAccent"
                        app:hintTextColor="@color/colorAccent"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/highContrast"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Options Row: Remember Me & Forgot Password -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <CheckBox
                            android:id="@+id/cb_remember_me"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/remember_me"
                            android:textColor="@color/highContrast"
                            android:textSize="13sp"
                            android:buttonTint="@color/authLinkColor"/>

                        <TextView
                            android:id="@+id/tv_forgot_password"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forgot_password"
                            android:textColor="@color/authLinkColor"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:background="?attr/selectableItemBackground"/>
                    </LinearLayout>

                    <!-- Primary Action Button: Sign In / Sign Up -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_submit"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/btn_sign_in"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/authLinkColor"
                            app:cornerRadius="12dp"/>

                        <ProgressBar
                            android:id="@+id/pb_login_loading"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <!-- Switch between Sign In / Sign Up -->
                    <TextView
                        android:id="@+id/tv_toggle_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="18dp"
                        android:text="@string/dont_have_account"
                        android:textColor="@color/authLinkColor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="?attr/selectableItemBackground"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Continue as Guest / Offline Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_skip_guest"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="18dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Continue as Guest (Local Shield Only)"
                android:textColor="@color/highContrast"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/authLinkColor"
                app:strokeColor="@color/cardBorder"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/cardBgSecondary"/>

            <!-- Reassuring Security & Privacy Footer -->
            <LinearLayout
                android:id="@+id/layout_security_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/metricTextSecondary"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="KotSafe Zero-Trust • On-Device Packet Inspection"
                    android:textColor="@color/metricTextSecondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.03"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

