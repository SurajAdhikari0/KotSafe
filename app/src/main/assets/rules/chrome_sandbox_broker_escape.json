      {
        "field": "contentStrings",
        "operator": "contains_any",
        "values": [
          "setuid(0)",
          "escalate_privileges",
          "trampoline_shellcode",
          "disable_selinux"
        ]
      }
    ]
  },
  "remediation": "Immediately remove malicious staging artifact and restart device into recovery mode to inspect kernel integrity."
}
