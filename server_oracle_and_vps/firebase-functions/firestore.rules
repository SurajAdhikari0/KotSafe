rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each pairing doc is keyed by its own random 16-byte token, which acts
    // as the credential — same trust model as the self-hosted server's
    // shared secret, just scoped to one pairing instead of the whole server.
    // Any authenticated (including anonymous) client that knows the exact
    // token can read/update candidates for that pairing. No one can list or
    // query the collection, so tokens cannot be enumerated or guessed by scanning.
    match /pairings/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if false; // only the createPairing Cloud Function may create docs
      allow update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['candidates', 'updatedAt', 'expiresAt', 'ownerUid'])
                    && request.resource.data.candidates.size() <= 20;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
