# KotSafe / KotSafe Relay Configuration
# Compatible with Oracle Cloud, AWS, DigitalOcean, Hetzner, or any Linux VPS

PORT=8081
# Generate using: openssl rand -hex 32
SHARED_SECRET=your_32_byte_hex_secret_here
ALLOW_ANONYMOUS=false
PAIRING_TTL_SECONDS=86400
# Your VPS Public IP or Domain (e.g. 130.210.16.110 or relay.yourdomain.com)
DOMAIN=your_vps_public_ip_or_domain
