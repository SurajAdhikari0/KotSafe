# Generate two different values with: openssl rand -base64 48
RELAY_SIGNING_KEY=replace-with-a-unique-48-byte-secret
CONTROL_API_TOKEN=replace-with-a-different-48-byte-secret
TURN_SHARED_SECRET=replace-with-a-third-48-byte-secret
TURN_HOST=turn.example.com

# Bind the control API to loopback. Put a TLS reverse proxy in front of it.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8081
CONTROL_PUBLIC_URL=https://control.example.com
