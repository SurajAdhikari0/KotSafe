# Run Caddy on the Oracle/VPS host. The Compose control service publishes only
# 127.0.0.1:8081, so it cannot be reached directly from the Internet.
# Replace control.example.com with your real DNS name.
control.example.com {
    reverse_proxy 127.0.0.1:8081
    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
}
