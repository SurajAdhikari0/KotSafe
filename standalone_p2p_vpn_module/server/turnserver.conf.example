# Coturn reference configuration for a non-Docker install.
# Replace every example value. Keep the TURN secret only on this server and
# the control backend; Android receives expiring derived credentials instead.
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_TURN_SHARED_SECRET
realm=turn.example.com
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49200
cert=/etc/letsencrypt/live/relay.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/relay.example.com/privkey.pem
no-cli
no-loopback-peers
no-multicast-peers
log-file=stdout
