# Use a distinct, random secret shared only by relay and control backend.
RELAY_SIGNING_KEY=replace-with-openssl-rand-base64-48
RELAY_PORT=9443

# Mount these read-only from your ACME/Let's Encrypt certificate location.
TLS_KEY_PATH=/run/secrets/relay-key.pem
TLS_CERT_PATH=/run/secrets/relay-cert.pem
